@{
    ViewData["Title"] = "Offline Import";
}

<div class="container-fluid px-4">
    <div class="row pt-1">
        <div class="col-12">
            <h1 class="fw-bold mb-0">OFFLINE LOG <span class="text-info">IMPORT</span></h1>
            <p class="text-secondary small">Select a folder containing offline payload files to import.</p>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-5">
            <div class="glass-card h-100">
                <h5 class="fw-bold mb-4">FOLDER SELECTION</h5>
                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold">DATABASE PROVIDER</label>
                    <select class="form-select bg-dark border-secondary text-info fw-bold" id="dbProvider">
                        <option value="Auto">Auto-Detect from Payload</option>
                        <option value="SqlServer">Microsoft SQL Server</option>
                        <option value="Postgres">PostgreSQL</option>
                        <option value="MySql">MySQL</option>
                        <option value="Oracle">Oracle</option>
                        <option value="AzureSql">Azure SQL</option>
                    </select>
                    <div class="small text-secondary mt-1">Select the provider type for the files you are about to import.</div>
                </div>

                <div class="mb-3">
                    <label for="folderPath" class="form-label text-secondary small fw-bold">FOLDER PATH</label>
                    <div class="input-group">
                        <input type="text" class="form-control bg-dark border-secondary text-white" id="folderPath" 
                            placeholder="C:\Path\To\MonitoringAgent\Logs\Payloads"

                            value="">
                        <button class="btn btn-outline-info" type="button" id="btnBrowse" title="Browse Server Folders">
                            <i class="bi bi-folder2-open"></i> BROWSE
                        </button>
                    </div>
                    <button class="btn btn-info w-100 mt-2 fw-bold" type="button" id="btnListFiles">LIST FILES</button>
                </div>
                
                <div class="mt-4 p-3 bg-dark-subtle rounded border border-secondary border-opacity-25 opacity-75">
                    <h6 class="small fw-bold mb-2">QUICK GUIDE</h6>
                    <ul class="small mb-0 text-secondary ps-3">
                        <li>Enter the folder path where the worker saves its JSON payloads.</li>
                        <li>The worker usually saves files as <b>payload_YYYYMMDD_HHMMSS.json</b>.</li>
                        <li>Once files are listed, select which ones you want to import.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">DETECTED PAYLOADS</h5>
                    <div>
                        <button class="btn btn-sm btn-info fw-bold" id="btnImport" disabled>IMPORT SELECTED</button>
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-dark table-hover table-sm small align-middle" id="fileTable">
                        <thead>
                            <tr>
                                <th style="width: 40px;"><input type="checkbox" id="selectAll"></th>
                                <th>FILE NAME</th>
                                <th>SIZE</th>
                                <th>LAST MODIFIED</th>
                            </tr>
                        </thead>
                        <tbody id="fileListBody">
                            <tr>
                                <td colspan="4" class="text-center py-4 text-secondary italic">Enter a folder path or use "Browse" to begin...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div id="importStatus" class="mt-3 d-none">
                    <div class="d-flex align-items-center mb-1">
                        <div class="progress flex-grow-1" style="height: 5px;">
                            <div id="importProgress" class="progress-bar progress-bar-striped progress-bar-animated bg-info" role="progressbar" style="width: 0%"></div>
                        </div>
                        <span id="importPercent" class="ms-2 small fw-bold text-info">0%</span>
                    </div>
                    <div id="statusText" class="small text-secondary">Processing files...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- BROWSE MODAL -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="browseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
            <div class="modal-header border-bottom border-secondary border-opacity-25">
                <h6 class="modal-title fw-bold text-info">SELECT FOLDER</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="bg-dark-subtle p-2 border-bottom border-secondary border-opacity-10 d-flex align-items-center">
                    <button class="btn btn-sm btn-outline-secondary me-2" id="btnGoUp" title="Go up one level">
                        <i class="bi bi-arrow-up-circle"></i>
                    </button>
                    <input type="text" class="form-control form-control-sm bg-dark border-secondary text-white-50" id="currentBrowserPath" readonly>
                </div>
                <div id="browserContent" style="height: 350px; overflow-y: auto;" class="p-2">
                    <!-- Folders list -->
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">CANCEL</button>
                <button type="button" class="btn btn-sm btn-info fw-bold px-4" id="btnSelectCurrent">SELECT FOLDER</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

@section Scripts {
    <script>
        $(function() {
            const $btnList = $('#btnListFiles');
            const $btnImport = $('#btnImport');
            const $folderPath = $('#folderPath');
            const $fileListBody = $('#fileListBody');
            const $selectAll = $('#selectAll');
            const $status = $('#importStatus');

            // ── BROWSE MODAL LOGIC ───────────────────────────────
            const $browseModal = new bootstrap.Modal('#browseModal');
            let currentPath = "";

            $('#btnBrowse').on('click', () => {
                loadDirectory($folderPath.val() || "");
                $browseModal.show();
            });

            $('#btnGoUp').on('click', () => {
                const parts = currentPath.split('\\').filter(x => x);
                if (parts.length > 0) {
                    parts.pop();
                    loadDirectory(parts.join('\\') + (parts.length === 1 ? '\\' : ''));
                } else {
                    loadDirectory("");
                }
            });

            $('#btnSelectCurrent').on('click', () => {
                $folderPath.val(currentPath);
                $browseModal.hide();
                $btnList.trigger('click');
            });

            function loadDirectory(path) {
                const $content = $('#browserContent');
                $content.html('<div class="text-center py-5 text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>');
                
                $.get('/Import/GetDirectories', { path: path })
                    .done(data => {
                        let dirs = [];
                        if (Array.isArray(data)) {
                            // Initial drives view
                            dirs = data;
                            currentPath = "";
                        } else {
                            dirs = data.directories;
                            currentPath = data.currentPath;
                        }
                        
                        $('#currentBrowserPath').val(currentPath || "My Computer");
                        
                        let html = '<div class="list-group list-group-flush">';
                        dirs.forEach(d => {
                            const icon = d.isDrive ? 'bi-hdd' : 'bi-folder';
                            html += `
                                <button type="button" class="list-group-item list-group-item-action bg-transparent border-0 text-light py-2 d-flex align-items-center mb-1 rounded dir-item" 
                                    data-path="${d.fullPath.replace(/\\/g, '\\\\')}">
                                    <i class="bi ${icon} text-info me-3 fs-5"></i>
                                    <span>${d.name}</span>
                                </button>
                            `;
                        });
                        html += '</div>';
                        
                        if (dirs.length === 0) {
                            html = '<div class="text-center py-5 text-secondary italic">No subdirectories found.</div>';
                        }
                        
                        $content.html(html);

                        $('.dir-item').on('click', function() {
                            loadDirectory($(this).data('path'));
                        });
                    })
                    .fail(xhr => {
                        $content.html(`<div class="alert alert-danger m-3 small">${xhr.responseText || 'Access denied.'}</div>`);
                    });
            }

            // ── LIST FILES ──────────────────────────────────────────
            $btnList.on('click', function() {
                const path = $folderPath.val();
                if (!path) {
                    alert('Please enter or select a folder path.');
                    return;
                }

                $btnList.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status"></span> Searching...');
                $fileListBody.html('<tr><td colspan="4" class="text-center py-4 text-secondary italic">Scanning directory...</td></tr>');

                $.get('/Import/ListFiles', { folderPath: path })
                    .done(function(files) {
                        if (files.length === 0) {
                            $fileListBody.html('<tr><td colspan="4" class="text-center py-4 text-warning">No payload files found in this directory.</td></tr>');
                            $btnImport.prop('disabled', true);
                            return;
                        }

                        let html = '';
                        files.forEach((f, index) => {
                            html += `
                                <tr>
                                    <td><input type="checkbox" class="file-check" data-name="${f.name}"></td>
                                    <td class="fw-bold">${f.name}</td>
                                    <td class="text-secondary">${f.size}</td>
                                    <td class="text-secondary small">${f.lastModified}</td>
                                </tr>
                            `;
                        });
                        $fileListBody.html(html);
                        $btnImport.prop('disabled', false);
                        $selectAll.prop('checked', false);
                    })
                    .fail(function(xhr) {
                        $fileListBody.html(`<tr><td colspan="4" class="text-center py-4 text-danger">Error: ${xhr.responseText || 'Could not access the folder.'}</td></tr>`);
                    })
                    .always(function() {
                        $btnList.prop('disabled', false).text('LIST FILES');
                    });
            });

            // ── SELECT ALL ──────────────────────────────────────────
            $selectAll.on('change', function() {
                $('.file-check').prop('checked', this.checked);
            });

            // ── IMPORT ──────────────────────────────────────────────
            $btnImport.on('click', function() {
                const filenames = $('.file-check:checked').map(function() { return $(this).data('name'); }).get();
                const path = $folderPath.val();

                if (filenames.length === 0) {
                    alert('Select at least one file to import.');
                    return;
                }

                if (!confirm(`Are you sure you want to import ${filenames.length} file(s)?`)) return;

                $btnImport.prop('disabled', true);
                $status.removeClass('d-none');
                $('#importProgress').css('width', '50%');
                $('#importPercent').text('50%');
                $('#statusText').text('Uploading and processing payload data...');

                $.ajax({
                    url: '/Import/ProcessFiles',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ 
                        folderPath: path, 
                        files: filenames, 
                        providerType: $('#dbProvider').val() 
                    }),
                    success: function(resp) {
                        $('#importProgress').css('width', '100%');
                        $('#importPercent').text('100%');
                        $('#statusText').html(`<span class="text-success fw-bold">✓ Success:</span> Imported ${resp.imported} payloads. Errors: ${resp.errors}`);
                        
                        setTimeout(() => {
                            if (confirm('Import complete! Go to dashboard to see results?')) {
                                window.location.href = '/Home/Index';
                            }
                        }, 1000);
                    },
                    error: function(xhr) {
                        $('#statusText').html(`<span class="text-danger fw-bold">✗ Error:</span> ${xhr.responseText || 'Failed to process files.'}`);
                        $btnImport.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
<style>
    .list-group-item-action:hover {
        background: rgba(0, 129, 255, 0.1) !important;
    }
    #browserContent::-webkit-scrollbar { width: 5px; }
    #browserContent::-webkit-scrollbar-track { background: transparent; }
    #browserContent::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
    #browseModal .modal-content {
        backdrop-filter: blur(20px);
        background: rgba(11, 14, 20, 0.95) !important;
    }
</style>
