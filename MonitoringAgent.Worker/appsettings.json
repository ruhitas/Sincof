{
  "SqlMonitoring": {
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=master;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Application Name=MonitoringAgent;",
    "TargetServers": [],
    "IncludeDBs": [
      "YourAppDb"
    ],
    "ExcludeDBs": [
      "master",
      "tempdb",
      "model",
      "msdb"
    ],
    "CollectionIntervals": {
      "MetricsSeconds": 60,
      "QueriesSeconds": 300,
      "IndexesMinutes": 1440,
      "EventsSeconds": 15
    },
    "FeatureToggles": {
      "EnableMetrics": true,
      "EnableQueries": true,
      "EnableIndexAnalysis": true,
      "EnableBlockingDetection": true,
      "EnableDeadlockDetection": true,
      "EnableAlerts": true,
      "EnableApiSending": false,
      "EnableWaitStats": true,
      "EnableTempDbMonitoring": true,
      "EnableVlfMonitoring": true,
      "EnableFailedLoginTracking": true,
      "EnableBufferCacheMonitoring": true,
      "EnableDiskSpd": false,
      "EnablePostgres": false,
      "EnableMySql": false,
      "EnableOracle": false,
      "EnableAzureSql": false
    },
    "IndexAnalysis": {
      "FragmentationThreshold": 30.0,
      "ReorganizeThreshold": 10.0,
      "UnusedIndexDays": 30,
      "MinPageCount": 1000,
      "MissingIndexMinImpact": 50.0
    },
    "AlertThresholds": {
      "CpuHighPercent": 90.0,
      "CpuMediumPercent": 75.0,
      "PleLowThreshold": 300,
      "PleCriticalThreshold": 100,
      "BlockingWaitTimeSeconds": 30,
      "MemoryHighPercent": 90.0,
      "VlfHighCount": 50,
      "TempDbHighUsageMb": 20480.0,
      "FailedLoginHighCount": 10,
      "BufferCacheHitRatioLowThreshold": 95.0
    },
    "Thresholds": {
      "CpuHigh": 80,
      "IoHigh": 70,
      "MemoryPressurePLE": 100,
      "LongQueryMs": 5000,
      "FragmentationHigh": 30,
      "DeadlockCount": 1,
      "BlockingDurationMs": 3000,
      "UnusedIndexDays": 7,
      "DTUHigh": 80,
      "LogUsageHigh": 70,
      "VlfHighCount": 50,
      "MaxBackupDays": 1,
      "MaxSysAdminCount": 5,
      "MaxFailedLoginsPerMin": 10,
      "MinBufferCacheHitRatio": 95.0,
      "MaxTempDbSizeMb": 20480
    },
    "Api": {
      "BaseUrl": "http://localhost:5230",
      "ApiKey": "CHANGE_ME_API_KEY",
      "TimeoutSeconds": 30,
      "RetryCount": 3,
      "RetryDelayMs": 1000
    },
    "AdvancedControls": {
      "CircuitBreakerThreshold": 5,
      "CircuitBreakerBackoffSeconds": 60,
      "ThrottleMaxSendsPerWindow": 120,
      "ThrottleWindowSeconds": 60,
      "MaintenanceWindowsUtc": [ "02:00-04:00" ],
      "HealthReportIntervalMinutes": 5
    },
    "Logging": {
      "MinimumLevel": "Information",
      "FilePath": "Logs/monitoring-.log",
      "RetainedFileCountLimit": 31
    },
    "DiskSpd": {
      "TestPath": "C:\\Temp\\DiskSpd\\test.dat",
      "FileSizeGB": 1,
      "DurationSec": 10,
      "WritePercent": 0,
      "BlockSizeKB": 4,
      "Threads": 1,
      "QueueDepth": 1,
      "PreferredArchitecture": "x86"
    }
  }
}
