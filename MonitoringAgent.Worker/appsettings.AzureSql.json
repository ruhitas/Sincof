{
  "SqlMonitoring": {
    "TargetServers": [
      {
        "Alias": "Cloud_AzureSql",
        "ProviderType": "AzureSql",
        "ConnectionString": "Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=YOUR_DB;Persist Security Info=False;User ID=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
        "IsEnabled": false
      }
    ],
    "FeatureToggles": {
      "EnableAzureSql": false
    }
  }
}
