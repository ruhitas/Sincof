<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DB Analyzer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dark-theme">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold mb-0 pt-0" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="text-info">DB</span> ANALYZER <span class="badge badge-info bg-info text-dark" style="font-size:0.6rem">PRO</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-1">
                        @{
                            var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
                        }
                        <li class="nav-item">
                            <a class="nav-link py-1 @(currentController == "Home" ? "active text-info fw-bold border-bottom border-info border-2" : "text-light")" asp-area="" asp-controller="Home" asp-action="Index">DASHBOARD</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 @(currentController == "Analysis" ? "active text-info fw-bold border-bottom border-info border-2" : "text-light")" asp-area="" asp-controller="Analysis" asp-action="Index">ANALYSIS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 @(currentController == "Servers" ? "active text-info fw-bold border-bottom border-info border-2" : "text-light")" asp-area="" asp-controller="Servers" asp-action="Index">SERVERS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 @(currentController == "Alerts" ? "active text-info fw-bold border-bottom border-info border-2" : "text-light")" asp-area="" asp-controller="Alerts" asp-action="Index">REPORTS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 @(currentController == "Queries" ? "active text-info fw-bold border-bottom border-info border-2" : "text-light")" asp-area="" asp-controller="Queries" asp-action="Index">QUERIES</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 @(currentController == "DiskAnalysis" ? "active text-info fw-bold border-bottom border-info border-2" : "text-light")" asp-area="" asp-controller="DiskAnalysis" asp-action="Index">DISK ANALYSIS</a>
                        </li>
                        <li class="nav-item ms-lg-3 border-start border-secondary ps-lg-3">
                            <a class="nav-link py-1 @(currentController == "Import" ? "active text-warning fw-bold border-bottom border-warning border-2" : "text-secondary")" asp-area="" asp-controller="Import" asp-action="Index">OFFLINE IMPORT</a>
                        </li>
                    </ul>
                    <div class="navbar-text text-secondary small py-1">
                        AGENT STATUS: <span class="text-success fw-bold">ONLINE</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
